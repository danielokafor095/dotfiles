# ============================================================
# Homebrew Bundle — 开发环境完整包清单
# 用法: brew bundle --file=Brewfile
# ============================================================

# 第三方 Tap
tap "asmvik/formulae"
tap "steipete/tap"

# CLI 工具
brew "bat"            # cat 替代，带语法高亮
brew "btop"           # 系统监控
brew "eza"            # ls 替代，带 git 状态
brew "fastfetch"      # 系统信息展示
brew "fd"             # find 替代
brew "ffmpeg"         # 音视频处理
brew "fnm"            # Node.js 版本管理
brew "fzf"            # 模糊搜索
brew "gh"             # GitHub CLI
brew "git"            # 版本控制
brew "git-delta"      # git diff 美化
brew "go"             # Go 语言
brew "lazygit"        # git TUI
brew "pnpm"           # Node 包管理器
brew "ripgrep"        # grep 替代
brew "tmux"           # 终端复用
brew "uv"             # Python 包管理器
brew "wget"           # 下载工具
brew "xcodegen"       # Xcode 项目生成
brew "zoxide"         # cd 替代，智能跳转

# 第三方 Tap 的包
brew "asmvik/formulae/skhd"   # 快捷键管理

# AI / LLM
brew "llama.cpp"      # 本地 LLM 推理

# GUI 应用
cask "appcleaner"                    # 应用卸载
cask "bruno"                         # API 客户端
cask "codex"                         # AI 编码
cask "codexbar"                      # 菜单栏工具
cask "cursor"                        # AI 编辑器
cask "docker-desktop"                # Docker
cask "istat-menus@6"                 # 系统监控菜单栏
cask "itsycal"                       # 菜单栏日历
cask "macs-fan-control"              # 风扇控制
cask "sfm"                           # 文件管理
cask "tableplus"                     # 数据库客户端
cask "visual-studio-code"            # 编辑器
cask "warp"                          # 终端模拟器

# 字体
cask "font-jetbrains-mono-nerd-font" # JetBrains Mono Nerd
cask "font-maple-mono-nf"            # Maple Mono Nerd
cask "font-meslo-lg-nerd-font"       # Meslo LG Nerd（P10k 推荐）
